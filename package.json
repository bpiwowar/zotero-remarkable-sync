{
  "name": "zotero-remarkable-sync",
  "type": "module",
  "version": "0.2.0",
  "description": "Sync Zotero PDFs and annotations with the reMarkable tablet",
  "config": {
    "addonName": "Zotero reMarkable Sync",
    "addonID": "zotero-remarkable-sync@piwowarski.fr",
    "addonRef": "remarkablesync",
    "addonInstance": "ZoteroReMarkableSync",
    "prefsPrefix": "extensions.zotero.remarkablesync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpiwowar/zotero-remarkable-sync.git"
  },
  "author": "Benjamin Piwowarski",
  "bugs": {
    "url": "https://github.com/bpiwowar/zotero-remarkable-sync/issues"
  },
  "homepage": "https://github.com/bpiwowar/zotero-remarkable-sync#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:parser": "esbuild src/modules/remarkable/rmlines.ts --bundle --format=esm --outfile=.scaffold/rmlines.mjs --log-level=error && node test/rmlines.verify.mjs",
    "test:writer": "esbuild src/modules/remarkable/rmlines.ts --bundle --format=esm --outfile=.scaffold/rmlines.mjs --log-level=error && esbuild src/modules/remarkable/rmwrite.ts --bundle --format=esm --outfile=.scaffold/rmwrite.mjs --log-level=error && node test/rmwrite.verify.mjs",
    "update-deps": "npm update --save",
    "prepare": "husky"
  },
  "dependencies": {
    "rmapi-js": "^10.1.0",
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "mocha": "^11.7.5",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,xhtml,css}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
