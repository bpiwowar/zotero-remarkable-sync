{
  "name": "zotero-remarkable-sync",
  "type": "module",
  "version": "0.8.0",
  "description": "Sync Zotero PDFs and annotations with the reMarkable tablet",
  "config": {
    "addonName": "Zotero reMarkable Sync",
    "addonID": "zotero-remarkable-sync@piwowarski.fr",
    "addonRef": "remarkablesync",
    "addonInstance": "ZoteroReMarkableSync",
    "prefsPrefix": "extensions.zotero.remarkablesync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpiwowar/zotero-remarkable-sync.git"
  },
  "author": "Benjamin Piwowarski",
  "bugs": {
    "url": "https://github.com/bpiwowar/zotero-remarkable-sync/issues"
  },
  "homepage": "https://github.com/bpiwowar/zotero-remarkable-sync#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:polyfills": "esbuild src/utils/polyfills.ts --bundle --format=esm --outfile=.scaffold/polyfills.mjs --log-level=error && node test/polyfills.verify.mjs",
    "update-deps": "npm update --save",
    "prepare": "husky",
    "devtest": "esbuild scripts/devtest.ts --bundle --platform=node --format=esm --outfile=.scaffold/devtest.mjs --log-level=error && node .scaffold/devtest.mjs",
    "test:shared": "esbuild src/modules/remarkable/zkey.ts --bundle --format=esm --outfile=.scaffold/zkey.mjs --log-level=error && esbuild src/modules/remarkable/annotations.ts --bundle --format=esm --outfile=.scaffold/annotations.mjs --log-level=error && esbuild src/modules/sync/state.ts --bundle --format=esm --outfile=.scaffold/state.mjs --log-level=error && esbuild src/modules/sync/strokes.ts --bundle --format=esm --outfile=.scaffold/strokes.mjs --log-level=error && node test/shared.verify.mjs",
    "build:wasm": "libs/remarkable-annotations/wasm/build-npm.sh"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "remarkable-annotations": "file:libs/remarkable-annotations/wasm/pkg",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "mocha": "^12.0.3",
    "prettier": "^3.7.4",
    "rmapi-js": "^14.4.2",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,xhtml,css}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
